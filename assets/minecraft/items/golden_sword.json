{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:component",
    "component": "minecraft:custom_name",
    "cases": [
      {
        "when": {
          "text": "錆びた剣",
          "color": "gold",
          "bold": true,
          "italic": false
        },
        "model": {
          "type": "minecraft:model",
          "model": "dekitate_event:item/under/rusty_sword"
        }
      },
      {
        "when": {
          "text": "ランク",
          "color": "white",
          "bold": true,
          "italic": false
        },
        "model": {
          "type": "minecraft:model",
          "model": "dekitate_event:item/dpass/rank_b"
        }
      },
      {
        "when": {
          "text": " ",
          "bold": true,
          "italic": false,
          "extra": [
            {
              "text": "B",
              "color": "dark_green"
            },
            {
              "text": " ランク",
              "color": "white"
            }
          ]
        },
        "model": {
          "type": "minecraft:model",
          "model": "dekitate_event:item/dpass/rank_b" 
        }
      }
    ],
    "fallback":{
      "type": "minecraft:range_dispatch",
      "property": "custom_model_data",
      "entries": [
            {
                "threshold": 1,
                "model": {
                    "type": "model",
                    "model": "custom/dungeon/ice_fortress/guardians_sword"
                }
            },
              {
                  "threshold": 2,
                  "model": {
                      "type": "model",
                      "model": "minecraft:item/golden_sword"
                  }
              }
        ],
        "fallback": {
            "type": "model",
            "model": "minecraft:item/golden_sword"
        }
    }
  }
}