{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:component",
    "component": "minecraft:custom_name",
    "cases": [
      {
        "when": {
          "text": "八咫鏡",
          "color": "yellow",
          "bold": true,
          "italic": false
        },
        "model": {
          "type": "minecraft:condition",
          "property": "minecraft:using_item",
          "on_false": {
            "type": "minecraft:model",
            "model": "dekitate_event:item/yomi/yata_no_kagami"
          },
          "on_true": {
            "type": "minecraft:model",
            "model": "dekitate_event:item/yomi/yata_no_kagami_blocking"
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:range_dispatch",
      "property": "minecraft:custom_model_data",
      "entries": [
        {
          "threshold": 1.0,
          "model": {
            "type": "minecraft:select",
            "property": "minecraft:display_context",
            "cases": [
              {
                "when": ["gui", "ground", "fixed"],
                "model": {
                  "type": "minecraft:model",
                  "model": "minecraft:custom/dungeon/yatano_mirror"
                }
              },
              {
                "when": ["head"],
                "model": {
                  "type": "minecraft:model",
                  "model": "minecraft:custom/dungeon/yatano_mirror_head"
                }
              }
            ],
            "fallback": {
              "type": "minecraft:condition",
              "property": "minecraft:using_item",
              "on_true": {
                "type": "minecraft:model",
                "model": "minecraft:custom/dungeon/yatano_mirror_blocking"
              },
              "on_false": {
                "type": "minecraft:model",
                "model": "minecraft:custom/dungeon/yatano_mirror"
              }
            }
          }
        },
        {
          "threshold": 2.0,
          "model": {
            "type": "minecraft:condition",
            "property": "minecraft:using_item",
            "on_false": {
              "type": "minecraft:special",
              "base": "minecraft:item/shield",
              "model": {
                "type": "minecraft:shield"
              }
            },
            "on_true": {
              "type": "minecraft:special",
              "base": "minecraft:item/shield_blocking",
              "model": {
                "type": "minecraft:shield"
              }
            }
          }
        }
      ],
      "fallback": {
        "type": "minecraft:condition",
        "property": "minecraft:using_item",
        "on_false": {
          "type": "minecraft:special",
          "base": "minecraft:item/shield",
          "model": {
            "type": "minecraft:shield"
          }
        },
        "on_true": {
          "type": "minecraft:special",
          "base": "minecraft:item/shield_blocking",
          "model": {
            "type": "minecraft:shield"
          }
        }
      }
    }
  }
}